+    def test_export_refuses_evidence_directory_symlink(self):
+        graph = self.graph()
+        outside = self.root / "outside"
+        outside.mkdir(mode=0o700)
+        sentinel = outside / "keep"
+        sentinel.write_bytes(b"untouched")
