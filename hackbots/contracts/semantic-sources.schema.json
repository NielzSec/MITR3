{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_sha256",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "mission_sha256": {
      "type": "string",
      "pattern": "[a-f0-9]{64}"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "[a-f0-9]{64}"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MITR3 reviewer-pinned auxiliary mission sources v1"
}
